# H2 local de la demo: sa sin clave. Producción: datasource y credenciales por variables/credential-store.
# Ejecutar sin WildFly en marcha. Se puede repetir.
embed-server --server-config=standalone-full.xml --std-out=discard
if (outcome != success) of /subsystem=datasources/data-source=GomarketDS:read-resource
    /subsystem=datasources/data-source=GomarketDS:add(jndi-name="java:jboss/datasources/GomarketDS", driver-name=h2, connection-url="jdbc:h2:file:${jboss.server.data.dir}/gomarket/gomarket;DB_CLOSE_ON_EXIT=FALSE", user-name=sa, jta=true, enabled=true)
end-if
stop-embedded-server
